{
  "name": "atscript",
  "version": "0.1.88",
  "description": "Atscript is a language for describing data and interfaces with extensible annotations, enabling the generation of files at runtime for streamlined workflows.",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build": "node ./scripts/build.js",
    "build-only": "node ./scripts/build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "version": "pnpm changelog && git add CHANGELOG.md && git commit -m 'chore: update changelog'",
    "release": "pnpm build && pnpm test && node ./scripts/versions patch && pnpm -r run pub",
    "release:minor": "pnpm build && pnpm test && node ./scripts/versions minor && pnpm -r run pub",
    "release:major": "pnpm build && pnpm test && node ./scripts/versions major && pnpm -r run pub",
    "vscode": "node ./scripts/vscode-publish",
    "sync": "node ./scripts/versions"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@prostojs/dye": "0.4.9",
    "@types/node": "^22.20.1",
    "@vscode/vsce": "^3.9.2",
    "conventional-changelog-cli": "^5.0.0",
    "husky": "^9.1.7",
    "inquirer": "^12.11.1",
    "oxfmt": "^0.34.0",
    "oxlint": "^1.76.0",
    "rolldown": "1.0.0-beta.1",
    "rollup": "^4.62.3",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.9",
    "vitepress": "2.0.0-alpha.17",
    "vitest": "3.2.7",
    "zx": "^8.8.5"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "minimatch": ">=10.2.3",
      "@vscode/vsce>minimatch": "^3.0.3",
      "fast-uri": ">=3.1.2",
      "lodash": ">=4.18.0",
      "handlebars": ">=4.7.9",
      "undici": ">=7.24.0",
      "vitest>vite": ">=7.3.2",
      "@vitest/mocker>vite": ">=7.3.2",
      "vite-node>vite": ">=7.3.2",
      "tmp": ">=0.2.6",
      "esbuild": ">=0.28.1"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
